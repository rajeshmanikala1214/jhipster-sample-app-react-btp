# Copy to "secrets.mtaext" (git-ignored), fill in the value, and deploy with:
#   cf deploy mta_archives/jhipster-sample-app-react_0.0.1.mtar -e secrets.mtaext
#
# Generate a JWT signing key (64 random bytes, base64) with:
#   openssl rand -base64 64 | tr -d '\n'
_schema-version: '3.1'
ID: jhipster-sample-app-react.secrets
extends: jhipster-sample-app-react

modules:
  - name: jhipster-react-app
    properties:
      JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET: <paste-generated-base64-secret-here>
